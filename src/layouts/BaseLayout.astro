---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';
import '../styles/portfolio-visuals.css';

const { title, description, current = '' } = Astro.props;
const fullTitle = title ? `${title} | Richard J. Allen` : 'Richard J. Allen | Operations Management & Customer Success Leader';
const siteUrl = Astro.site ?? new URL('https://richard-allen-professional-portfoli.vercel.app');
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const publicEmail = 'rjallencareer@gmail.com';
const linkedInUrl = 'https://www.linkedin.com/in/richardjallen';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Richard J. Allen',
  url: siteUrl.toString(),
  email: `mailto:${publicEmail}`,
  sameAs: [linkedInUrl],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Keizer',
    addressRegion: 'Oregon',
    addressCountry: 'US'
  },
  knowsAbout: [
    'Operations Management',
    'Customer Success',
    'People Leadership',
    'Process Improvement',
    'Implementation',
    'Enablement',
    'Training',
    'Operational Reporting'
  ]
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Richard J. Allen Professional Portfolio',
  url: siteUrl.toString(),
  description
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#153e75" />
  <meta name="robots" content="index, follow" />

  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Richard J. Allen Professional Portfolio" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>

  <title>{fullTitle}</title>
  <Analytics />
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <Header current={current} />
  <main id="main-content"><slot /></main>
  <Footer />
</body>
</html>

<style is:global>
  :root { --gold: #9a6518; }
  .skip-link {
    position: fixed;
    left: 1rem;
    top: 1rem;
    z-index: 1000;
    padding: .7rem 1rem;
    border-radius: 8px;
    background: #fff;
    color: #153e75;
    font-weight: 800;
    box-shadow: 0 8px 24px rgba(0,0,0,.18);
    transform: translateY(-180%);
    transition: transform .15s ease;
  }
  .skip-link:focus { transform: translateY(0); }
  a:focus-visible,
  button:focus-visible,
  [tabindex]:focus-visible {
    outline: 3px solid #0f766e;
    outline-offset: 3px;
    border-radius: 5px;
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
      scroll-behavior: auto !important;
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: .01ms !important;
    }
  }
</style>
