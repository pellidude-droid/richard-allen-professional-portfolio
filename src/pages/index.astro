---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout current="/" description="Richard J. Allen is a customer success and operations leader with experience in SaaS support, enablement, process improvement, training, and cross-functional operations.">
  <section class="hero"><div class="container">
    <div class="eyebrow">Customer Success · Operations · Enablement</div>
    <h1>Helping customers, teams, and processes work better together.</h1>
    <p class="lede">I’m Richard Allen, a customer success and operations leader based in Oregon. My background spans SaaS/software support, customer experience, team leadership, onboarding and training, process improvement, reporting, and cross-functional operations.</p>
    <div class="actions"><a class="button" href="/case-studies/">View selected work</a><a class="button secondary" href="/resume/">View résumé</a><a class="button secondary" href="/contact/">Contact</a></div>
  </div></section>
  <section class="section"><div class="container">
    <div class="grid">
      <div class="card"><div class="metric">100+</div><div class="metric-label">SOPs in a multi-month standardization initiative</div></div>
      <div class="card"><div class="metric">400+</div><div class="metric-label">workforce position records managed across multiple divisions</div></div>
      <div class="card"><div class="metric">10+</div><div class="metric-label">customer and technical-support team members led and coached</div></div>
    </div>
  </div></section>
  <section class="section"><div class="container">
    <h2>Where I add value</h2>
    <div class="grid two">
      <article class="card"><h3>Customer success & support leadership</h3><p>Customer relationships, technical support, escalations, training, customer feedback, service improvement, and team coaching in software and service environments.</p><a href="/customer-success/">Customer success experience →</a></article>
      <article class="card"><h3>Operations & people leadership</h3><p>Workflow coordination, team leadership, reporting, cross-functional execution, process ownership, and management of competing operational priorities.</p><a href="/operations-leadership/">Operations experience →</a></article>
      <article class="card"><h3>Process improvement</h3><p>SOP development, standardization, reporting, quality improvement, workflow analysis, and translating operational data into usable decisions.</p><a href="/process-improvement/">Process improvement work →</a></article>
      <article class="card"><h3>Implementation, onboarding & enablement</h3><p>Software-change readiness, database migration coordination, customer and staff training, onboarding materials, and release communication.</p><a href="/implementation-enablement/">Implementation & enablement →</a></article>
    </div>
  </div></section>
</BaseLayout>
