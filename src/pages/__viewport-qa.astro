---
const routes = [
  ['Home','/'],
  ['Operations','/operations-leadership/'],
  ['Customer Success','/customer-success/'],
  ['Process Improvement','/process-improvement/'],
  ['Implementation','/implementation-enablement/'],
  ['Case Studies','/case-studies/']
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Temporary Viewport QA</title>
  <style>
    *{box-sizing:border-box}body{margin:0;font-family:system-ui,sans-serif;background:#eef2f6;color:#16202a}header{position:sticky;top:0;z-index:5;background:#fff;border-bottom:1px solid #ccd6e0;padding:12px 16px}h1{font-size:18px;margin:0 0 10px}.routes{display:flex;gap:8px;flex-wrap:wrap}.routes button{border:1px solid #9badc0;border-radius:8px;background:#fff;padding:7px 10px;font-weight:700;cursor:pointer}.routes button.active{background:#153e75;color:#fff;border-color:#153e75}.meta{font-size:12px;color:#5a6978;margin-top:8px}.stage{display:grid;grid-template-columns:420px 800px;gap:18px;padding:18px;align-items:start;min-width:1260px}.panel{background:#fff;border:1px solid #cad5df;border-radius:12px;padding:12px;box-shadow:0 8px 24px rgba(20,40,60,.07)}.panel h2{font-size:15px;margin:0 0 8px}.frame-wrap{overflow:auto;background:#dce5ed;padding:8px;border-radius:8px}.mobile-frame{width:390px;height:844px;border:0;background:#fff;display:block}.tablet-frame{width:768px;height:1024px;border:0;background:#fff;display:block}.diag{margin-top:8px;white-space:pre-wrap;font:12px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace;background:#0f1720;color:#e7f0f7;padding:10px;border-radius:8px;min-height:92px}.pass{color:#7ee787}.fail{color:#ff7b72}
  </style>
</head>
<body>
<header>
  <h1>Temporary exact-viewport QA harness</h1>
  <div class="routes">
    {routes.map(([label,path],i)=><button class={i===0?'active':''} data-route={path}>{label}</button>)}
  </div>
  <div class="meta">Real same-origin iframe viewports: mobile 390×844 · tablet 768×1024. Diagnostics measure rendered document width and element bounds.</div>
</header>
<main class="stage">
  <section class="panel">
    <h2 id="mobile-title">Mobile · Home · 390×844</h2>
    <div class="frame-wrap"><iframe id="mobile" class="mobile-frame" src="/" title="Mobile viewport"></iframe></div>
    <div id="mobile-diag" class="diag">Loading…</div>
  </section>
  <section class="panel">
    <h2 id="tablet-title">Tablet · Home · 768×1024</h2>
    <div class="frame-wrap"><iframe id="tablet" class="tablet-frame" src="/" title="Tablet viewport"></iframe></div>
    <div id="tablet-diag" class="diag">Loading…</div>
  </section>
</main>
<script>
  const routeLabels = new Map([
    ['/','Home'],
    ['/operations-leadership/','Operations'],
    ['/customer-success/','Customer Success'],
    ['/process-improvement/','Process Improvement'],
    ['/implementation-enablement/','Implementation'],
    ['/case-studies/','Case Studies']
  ]);

  function inspectFrame(frame, out){
    try {
      const w = frame.contentWindow;
      const d = frame.contentDocument;
      const root = d.documentElement;
      const body = d.body;
      const vw = w.innerWidth;
      const nav = d.querySelector('.nav');
      const candidates = [...d.querySelectorAll('body *')].filter(el => {
        if (el.closest('.nav')) return false;
        const s = w.getComputedStyle(el);
        if (s.display === 'none' || s.visibility === 'hidden') return false;
        const r = el.getBoundingClientRect();
        return r.width > 0 && (r.right > vw + 1 || r.left < -1);
      }).slice(0,8).map(el => {
        const r = el.getBoundingClientRect();
        const cls = typeof el.className === 'string' && el.className ? '.' + el.className.trim().split(/\s+/).slice(0,2).join('.') : '';
        return `${el.tagName.toLowerCase()}${cls} [${Math.round(r.left)},${Math.round(r.right)}]`;
      });
      const docWidth = Math.max(root.scrollWidth, body?.scrollWidth || 0);
      const overflow = docWidth > vw + 1;
      const navInfo = nav ? `nav ${nav.clientWidth}/${nav.scrollWidth}px overflow-x=${w.getComputedStyle(nav).overflowX}` : 'nav n/a';
      out.innerHTML = `${overflow?'<span class="fail">FAIL horizontal overflow</span>':'<span class="pass">PASS no page-level overflow</span>'}\ninnerWidth=${vw}px documentWidth=${docWidth}px\n${navInfo}\nout-of-bounds (excluding scrollable nav): ${candidates.length?candidates.join('; '):'none'}`;
    } catch(err){ out.textContent = 'Inspection error: ' + err; }
  }

  const mobile = document.querySelector('#mobile');
  const tablet = document.querySelector('#tablet');
  mobile.addEventListener('load',()=>setTimeout(()=>inspectFrame(mobile,document.querySelector('#mobile-diag')),350));
  tablet.addEventListener('load',()=>setTimeout(()=>inspectFrame(tablet,document.querySelector('#tablet-diag')),350));

  document.querySelectorAll('[data-route]').forEach(btn => btn.addEventListener('click',()=>{
    document.querySelectorAll('[data-route]').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    const route = btn.dataset.route;
    const label = routeLabels.get(route) || route;
    document.querySelector('#mobile-title').textContent = `Mobile · ${label} · 390×844`;
    document.querySelector('#tablet-title').textContent = `Tablet · ${label} · 768×1024`;
    document.querySelector('#mobile-diag').textContent='Loading…';
    document.querySelector('#tablet-diag').textContent='Loading…';
    mobile.src = route;
    tablet.src = route;
  }));
</script>
</body>
</html>
