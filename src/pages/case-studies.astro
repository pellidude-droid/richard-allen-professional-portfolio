---
import BaseLayout from '../layouts/BaseLayout.astro';
const cases = [
  {tone:'teal',title:'Leading a 125+ SOP modernization program',context:'Oregon Employment Department',challenge:'A large body of operating procedures was fragmented, inconsistent, incomplete, and difficult to maintain.',action:'Led a year-long SOP modernization and governance effort across roughly 10 functional groups. The program ultimately encompassed 125+ SOPs, including 25+ legacy procedures inventoried and updated, with standardized templates, contributor coaching, review controls, and centralized storage.',outcome:'Created a stronger foundation for consistent procedures, easier access, clearer ownership, and ongoing maintenance.'},
  {tone:'blue',title:'Managing customer and technical support at scale',context:'HawkSoft',challenge:'A growing software company needed day-to-day support operations, people development, quality, workload coverage, and escalations to stay coordinated.',action:'Progressed from Team Lead to Customer Support Manager in 2015 and managed 32 Customer Support and Technical Support representatives with hiring and disciplinary authority, performance management, stand-ups, coaching, quality review, workload coverage, and operational reporting.',outcome:'Built repeatable management routines around people, performance, quality, communication, and service operations.'},
  {tone:'gold',title:'Mapping the customer journey across departments',context:'HawkSoft',challenge:'Individual teams could see their own part of the customer experience, but the organization needed a broader lifecycle view.',action:'Co-led a cross-functional Customer Journey / Customer Lifeline initiative for about a year with approximately 26 participants, mapping touchpoints across the customer relationship.',outcome:'Gave teams a shared framework for discussing handoffs and friction across departmental boundaries and materially supported retention improvement.'},
  {tone:'violet',title:'Moving hundreds of agencies to a new hosted environment',context:'HawkSoft',challenge:'A major hosted-service transition had a critical deadline and required customer communication, technical coordination, and support continuity.',action:'Project-managed and coordinated the migration of hundreds of insurance agencies from the legacy hosted environment to a replacement provider.',outcome:'Completed the migration at least one month ahead of the critical deadline while keeping customer and support coordination connected.'},
  {tone:'blue',title:'Preparing support teams for a major software change',context:'HawkSoft',challenge:'A substantial accounting-software redesign required staff to understand new workflows and be ready before customers encountered them.',action:'Led six months of advance communication, biweekly developer/staff education during the final two months, extra launch coverage, and continued training after go-live.',outcome:'Turned release readiness into a sustained change-management effort rather than a one-day launch event.'},
  {tone:'teal',title:'Maintaining workforce visibility across 400+ positions',context:'Oregon Health Authority',challenge:'Leaders needed reliable position information and recurring reporting across multiple divisions and functions.',action:'Managed 400+ position records, organizational charts, vacancy and position trackers, and 20+ recurring or ad-hoc reports while coordinating with Recruiting, HR, Classification & Compensation, Budget, DEI, and leadership.',outcome:'Maintained a more consistent operating picture of workforce status for cross-functional and leadership use.'},
  {tone:'gold',title:'Building a Customer Experience function',context:'The Kotter Group',challenge:'Customer relationships, feedback, education, and communications needed a more deliberate operating home.',action:'Established and managed a Customer Experience / Customer Success function, maintained relationships across the client base, gathered feedback, resolved issues, and created training documentation, presentations, webinars, online content, and customer communications.',outcome:'Created a practical customer-feedback and education loop supporting service improvement and retention work.'},
  {tone:'violet',title:'Leading warehouse and supply operations',context:'Aramark Foodservice',challenge:'Daily foodservice distribution required people, purchasing, inventory, receiving, storage, shipping, sanitation, and driver activity to stay coordinated.',action:'Typically supervised about 20 people across warehouse staff, drivers, and inmate workers while overseeing procurement/supply duties, receiving, storage, distribution, shipping, sanitation, and driver or small-fleet activity for more than $1 million in inventory annually.',outcome:'Built early hands-on management experience balancing people, inventory, deadlines, and operational reliability.'}
];
---
<BaseLayout title="Selected Work / Case Studies" current="/case-studies/" description="Selected, source-controlled case studies from Richard Allen's work in operations management, process improvement, SaaS support, change management, customer experience, reporting, and workforce operations.">
<section class="page-intro"><div class="container"><div class="eyebrow">Selected Work / Case Studies</div><h1>Examples of how I approach messy operational problems.</h1><p class="lede">The settings change, but the pattern is consistent: understand the work, make it visible, coordinate the people involved, improve the process, and leave behind something more repeatable.</p></div></section>

<section class="section impact-section"><div class="container">
  <div class="proof-ribbon case-ribbon"><span><strong>32</strong> support & technical-support reps managed</span><span><strong>125+</strong> SOP program</span><span><strong>400+</strong> position records</span><span><strong>~20</strong> people in warehouse operations</span></div>
  <div class="case-method" aria-label="Case study method"><div><span>1</span><strong>See the problem</strong></div><div>→</div><div><span>2</span><strong>Organize the work</strong></div><div>→</div><div><span>3</span><strong>Coordinate people</strong></div><div>→</div><div><span>4</span><strong>Make it repeatable</strong></div></div>
</div></section>

<section class="section"><div class="container">
  <div class="section-heading-row"><div><div class="eyebrow">Eight examples</div><h2>Evidence across different environments.</h2></div><p class="section-note">Operations management, SaaS support, customer experience, process governance, change, workforce reporting, and supply operations.</p></div>
  <div class="case-grid">
    {cases.map((c,i) => <article class={`case-card ${c.tone}`}><div class="case-number">{String(i+1).padStart(2,'0')}</div><div class="kicker">{c.context}</div><h3>{c.title}</h3><div class="case-section"><strong>Challenge</strong><p>{c.challenge}</p></div><div class="case-section"><strong>Action</strong><p>{c.action}</p></div><div class="case-section result"><strong>Result</strong><p>{c.outcome}</p></div></article>)}
  </div>
</div></section>

<section class="section tight"><div class="container"><div class="callout"><strong>Want the concise version?</strong> The résumé provides the career timeline; the role-specific pages organize the same verified experience by hiring need.</div><div class="actions"><a class="button" href="/resume/">View résumé</a><a class="button secondary" href="/operations-leadership/">Operations & leadership</a><a class="button secondary" href="/contact/">Contact</a></div></div></section>
</BaseLayout>
