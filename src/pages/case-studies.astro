---
import BaseLayout from '../layouts/BaseLayout.astro';
const cases = [
  {tone:'teal',title:'Revamping a 100+ SOP initiative',context:'Oregon Employment Department',challenge:'A large body of operating procedures needed stronger organization, consistency, governance, and sustained attention.',action:'Led/co-led a year-long SOP modernization and governance effort across roughly 10 functional groups, inventorying and updating 25+ legacy procedures, documenting missing processes, standardizing templates and review controls, and centralizing a library that ultimately identified, created, and collected 100+ SOPs.',outcome:'Created a stronger foundation for consistent procedures, centralized access, ongoing maintenance, and process-improvement work.'},
  {tone:'blue',title:'Mapping the customer journey across departments',context:'HawkSoft',challenge:'Individual teams could see their own part of the customer experience, but the organization needed a broader lifecycle view.',action:'Co-led a cross-functional Customer Journey / Customer Lifeline initiative for about a year, mapping customer touchpoints across the relationship.',outcome:'Gave teams a shared framework for discussing handoffs, friction, and the customer experience across departmental boundaries.'},
  {tone:'gold',title:'Preparing support teams for a major software change',context:'HawkSoft',challenge:'A substantial accounting-system change required staff to understand new workflows and be ready before customers encountered them.',action:'Supported six months of advance communication, recurring developer/staff coordination during the final two months, extra launch support, and continued training after go-live.',outcome:'Turned release support into a sustained change-management effort rather than a one-day launch event.'},
  {tone:'violet',title:'Turning raw support data into leadership reporting',context:'HawkSoft',challenge:'Large support and phone-system data exports were difficult to use directly for management decisions.',action:'Cleaned and analyzed Excel data, built pivots and KPI-style reporting, and converted operational activity into management-ready information.',outcome:'Made support trends easier for leadership to review and use in operational discussions.'},
  {tone:'blue',title:'Managing workforce visibility across 400+ positions',context:'Oregon Health Authority',challenge:'Leaders needed reliable position information across multiple divisions and functions.',action:'Managed 400+ position records, organizational charts, vacancy and position trackers, and 20+ recurring or ad-hoc reports while coordinating with Recruiting, HR, Classification & Compensation, Budget, DEI, and leadership.',outcome:'Maintained a more consistent operating picture of workforce status for cross-functional and leadership use.'},
  {tone:'teal',title:'Building a Customer Experience function',context:'The Kotter Group',challenge:'Customer relationships, feedback, education, and communications needed a more deliberate operating home.',action:'Established and managed a Customer Experience function, maintained client relationships, gathered feedback, and created training documentation, presentations, webinars, online content, and customer communications.',outcome:'Created a practical customer-feedback and education loop supporting service improvement and retention work.'},
  {tone:'gold',title:'Auditing high-volume claims during changing guidance',context:'Oregon Employment Department',challenge:'Pandemic Unemployment Assistance work required accuracy and adaptability while federal and state guidance continued to change.',action:'Audited hundreds of applications using Excel, tracking, and research tools while contributing to training and onboarding materials.',outcome:'Supported accuracy, consistency, and team learning in a fast-changing operational environment.'},
  {tone:'violet',title:'Leading warehouse and supply operations',context:'Aramark Foodservice',challenge:'Daily foodservice distribution required people, purchasing, inventory, receiving, storage, shipping, sanitation, and driver activity to stay coordinated.',action:'Typically supervised about 20 people across warehouse staff, drivers, and inmate workers while overseeing procurement/supply duties, receiving, storage, distribution, shipping, sanitation, and driver or small-fleet activity for more than $1 million in inventory annually.',outcome:'Built early hands-on management experience balancing people, inventory, deadlines, and operational reliability.'}
];
---
<BaseLayout title="Selected Work / Case Studies" current="/case-studies/" description="Selected, source-controlled case studies from Richard Allen's work in operations, process improvement, SaaS support, change management, customer experience, reporting, and workforce operations.">
<section class="page-intro"><div class="container"><div class="eyebrow">Selected Work / Case Studies</div><h1>Examples of how I approach messy operational problems.</h1><p class="lede">The settings change, but the pattern is consistent: understand the work, make it visible, coordinate the people involved, improve the process, and leave behind something more repeatable.</p></div></section>

<section class="section impact-section"><div class="container">
  <div class="proof-ribbon case-ribbon"><span><strong>100+</strong> SOP initiative</span><span><strong>400+</strong> position records</span><span><strong>20+</strong> workforce reports</span><span><strong>~20</strong> people in warehouse operations</span></div>
  <div class="case-method" aria-label="Case study method"><div><span>1</span><strong>See the problem</strong></div><div>→</div><div><span>2</span><strong>Organize the work</strong></div><div>→</div><div><span>3</span><strong>Coordinate people</strong></div><div>→</div><div><span>4</span><strong>Make it repeatable</strong></div></div>
</div></section>

<section class="section"><div class="container">
  <div class="section-heading-row"><div><div class="eyebrow">Eight examples</div><h2>Evidence across different environments.</h2></div><p class="section-note">Public-sector operations, SaaS support, customer experience, reporting, change, and warehouse leadership.</p></div>
  <div class="case-grid">
    {cases.map((c,i) => <article class={`case-card ${c.tone}`}><div class="case-number">{String(i+1).padStart(2,'0')}</div><div class="kicker">{c.context}</div><h3>{c.title}</h3><div class="case-section"><strong>Challenge</strong><p>{c.challenge}</p></div><div class="case-section"><strong>Action</strong><p>{c.action}</p></div><div class="case-section result"><strong>Result</strong><p>{c.outcome}</p></div></article>)}
  </div>
</div></section>
</BaseLayout>
