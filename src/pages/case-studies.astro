---
import BaseLayout from '../layouts/BaseLayout.astro';
const supportingCases = [
  {tone:'blue',title:'Preparing support teams for a major software change',context:'HawkSoft',challenge:'A substantial accounting-software redesign required staff to understand new workflows before customers encountered them.',action:'Created and participated in training for the redesign, supported six months of advance communication, biweekly developer/staff education during the final two months, extra launch coverage, and continued training after go-live.',outcome:'Turned release readiness into a sustained change-management effort rather than a one-day launch event.'},
  {tone:'teal',title:'Finding and correcting hundreds of personnel-data errors',context:'Oregon Health Authority',challenge:'A monthly personnel-error report covered roughly 3,000 employees and needed to be narrowed, reviewed, and corrected accurately for Richard’s assigned OHA groups.',action:'Filtered the report to about 400 employees, reviewed roughly 30 data fields per employee, identified anomalies, corrected records in Workday and other systems, and used coworker review as an additional accuracy control.',outcome:'Found and fixed hundreds of employment-information errors, including payroll-related mistakes, while maintaining broader position and workforce reporting.'},
  {tone:'gold',title:'Building a Customer Experience function',context:'The Kotter Group',challenge:'Customer relationships, feedback, education, and communications needed a more deliberate operating home.',action:'Established and managed a Customer Experience / Customer Success function, maintained relationships across the client base, gathered feedback, resolved issues, and created training documentation, presentations, webinars, online content, and customer communications.',outcome:'Created a practical customer-feedback and education loop supporting service improvement and retention work.'},
  {tone:'violet',title:'Leading warehouse and supply operations',context:'Aramark Foodservice',challenge:'Daily foodservice distribution required people, purchasing, inventory, receiving, storage, shipping, sanitation, and driver activity to stay coordinated.',action:'Typically supervised about 20 people across warehouse staff, drivers, and inmate workers while overseeing procurement/supply duties, receiving, storage, distribution, shipping, sanitation, and driver or small-fleet activity for more than $1 million in inventory annually.',outcome:'Built early hands-on management experience balancing people, inventory, deadlines, and operational reliability.'}
];
---
<BaseLayout title="Selected Work / Case Studies" current="/case-studies/" description="Selected, source-controlled case studies from Richard Allen's work in operations management, process improvement, SaaS support, change management, customer experience, reporting, and workforce operations.">
<section class="case-hero"><div class="container case-hero-grid">
  <div><div class="eyebrow light">Selected Work / Case Studies</div><h1>Operational problems made visible—and more manageable.</h1><p class="lede">Four flagship stories show the pattern behind my work: understand the problem, build structure around it, coordinate the people involved, and leave behind something clearer and more repeatable.</p></div>
  <div class="case-hero-proof" aria-label="Selected career proof"><span><strong>32</strong> people managed</span><span><strong>125+</strong> SOP program</span><span><strong>Hundreds</strong> of agencies migrated</span><span><strong>~26</strong> customer-journey participants</span></div>
</div></section>

<section class="section flagship-section"><div class="container">
  <div class="section-heading-row"><div><div class="eyebrow">Flagship work</div><h2>Four visual stories recruiters can scan quickly.</h2></div><p class="section-note">Each one separates the challenge, my role, the operating approach, and the result.</p></div>

  <article class="flagship flagship-teal">
    <div class="flagship-heading"><div><span class="flagship-no">01</span><div class="kicker">HawkSoft · People Management</div><h3>Managing customer and technical support at scale</h3></div><div class="flagship-result"><strong>32</strong><span>representatives managed as Customer Support Manager, excluding four team leads</span></div></div>
    <div class="flagship-grid">
      <div class="visual-panel org-story" aria-label="Leadership progression from Team Lead managing 21 people to Customer Support Manager managing 32 representatives plus four team leads outside the 32">
        <div class="progression-step"><small>TEAM LEAD</small><strong>21</strong><span>people managed</span></div>
        <div class="progression-arrow">→</div>
        <div class="progression-step manager-step"><small>CUSTOMER SUPPORT MANAGER · 2015</small><strong>32</strong><span>Customer Support + Technical Support representatives</span><div class="lead-chips"><i>TL</i><i>TL</i><i>TL</i><i>TL</i><b>4 team leads not included in the 32</b></div></div>
      </div>
      <div class="story-copy"><div><strong>Challenge</strong><p>A growing software company needed day-to-day support operations, people development, quality, workload coverage, and escalations to stay coordinated.</p></div><div><strong>Role & action</strong><p>Managed 21 people as Team Lead before promotion to Customer Support Manager, then managed 32 representatives with hiring and disciplinary authority, performance management, stand-ups, coaching, quality review, workload coverage, escalations, and operational reporting.</p></div><div class="story-outcome"><strong>Result</strong><p>Built repeatable management routines around people, performance, quality, communication, and service operations.</p></div></div>
    </div>
  </article>

  <article class="flagship flagship-blue">
    <div class="flagship-heading"><div><span class="flagship-no">02</span><div class="kicker">Oregon Employment Department · Process Governance</div><h3>Leading a 125+ SOP modernization program</h3></div><div class="flagship-result"><strong>125+</strong><span>SOPs encompassed by the year-long program</span></div></div>
    <div class="flagship-grid reverse">
      <div class="visual-panel sop-story" aria-label="SOP modernization from fragmented procedures to standards and review controls to a centralized governed library">
        <div class="sop-story-step scattered"><div class="paper-mini"><i></i><i></i><i></i></div><strong>Fragmented</strong><small>legacy + missing procedures</small></div>
        <span class="story-arrow">→</span>
        <div class="sop-story-step standard"><div class="standard-ring">STD</div><strong>Standardize</strong><small>templates · review · coaching</small></div>
        <span class="story-arrow">→</span>
        <div class="sop-story-step library"><strong>125+</strong><span>centralized program</span><small>including 25+ legacy procedures inventoried and updated</small></div>
      </div>
      <div class="story-copy"><div><strong>Challenge</strong><p>A large body of operating procedures was fragmented, inconsistent, incomplete, and difficult to maintain.</p></div><div><strong>Role & action</strong><p>Led a year-long modernization and governance effort across roughly 10 functional groups with standardized templates, contributor coaching, review controls, updated legacy procedures, documentation of missing processes, and centralized storage.</p></div><div class="story-outcome"><strong>Result</strong><p>Created a stronger foundation for consistent procedures, easier access, clearer ownership, and ongoing maintenance.</p></div></div>
    </div>
  </article>

  <article class="flagship flagship-violet">
    <div class="flagship-heading"><div><span class="flagship-no">03</span><div class="kicker">HawkSoft · Migration & Change</div><h3>Moving hundreds of agencies through a critical hosting transition</h3></div><div class="flagship-result"><strong>1+ mo.</strong><span>ahead of the critical deadline</span></div></div>
    <div class="flagship-grid">
      <div class="visual-panel migration-story" aria-label="Hundreds of insurance agencies moved from the Kotter-hosted HawkSoft Online environment to a Portland-area replacement provider">
        <div class="host-box legacy"><small>LEGACY</small><strong>Kotter-hosted HawkSoft Online</strong></div>
        <div class="migration-middle"><div class="agency-dots" aria-hidden="true">{Array.from({length:18}).map(() => <i></i>)}</div><div class="migration-line"><span></span></div><strong>Hundreds of agencies</strong><small>customer communication + technical coordination + support continuity</small></div>
        <div class="host-box replacement"><small>REPLACEMENT</small><strong>Portland-area hosted provider</strong><span>Completed 1+ month early</span></div>
      </div>
      <div class="story-copy"><div><strong>Challenge</strong><p>A major hosted-service transition had a critical deadline and required customer communication, technical coordination, and support continuity.</p></div><div><strong>Role & action</strong><p>Project-managed and coordinated the migration of hundreds of insurance agencies from the Kotter-hosted HawkSoft Online environment to a Portland-area replacement provider.</p></div><div class="story-outcome"><strong>Result</strong><p>Completed the migration at least one month ahead of the critical deadline while keeping customer and support coordination connected.</p></div></div>
    </div>
  </article>

  <article class="flagship flagship-gold">
    <div class="flagship-heading"><div><span class="flagship-no">04</span><div class="kicker">HawkSoft · Customer Experience</div><h3>Mapping the customer journey across departments</h3></div><div class="flagship-result"><strong>~26</strong><span>cross-functional participants</span></div></div>
    <div class="flagship-grid reverse">
      <div class="visual-panel journey-story" aria-label="Cross-functional customer journey spanning the relationship lifecycle">
        <div class="journey-track"><span></span><span></span><span></span><span></span><span></span></div>
        <div class="journey-labels"><div><strong>Discover</strong><small>first contact</small></div><div><strong>Adopt</strong><small>onboarding & use</small></div><div><strong>Support</strong><small>service & troubleshooting</small></div><div><strong>Grow</strong><small>value & relationship</small></div><div><strong>Retain</strong><small>continuity & loyalty</small></div></div>
        <div class="journey-people"><strong>~26</strong><span>people working across departmental boundaries</span></div>
      </div>
      <div class="story-copy"><div><strong>Challenge</strong><p>Individual teams could see their own part of the customer experience, but the organization needed a broader lifecycle view.</p></div><div><strong>Role & action</strong><p>Co-led a Customer Journey / Customer Lifeline initiative for about a year with approximately 26 participants, mapping customer touchpoints and helping teams examine handoffs and friction beyond their own departments.</p></div><div class="story-outcome"><strong>Result</strong><p>Created a shared framework for discussing the customer lifecycle and materially supported retention-improvement work.</p></div></div>
    </div>
  </article>
</div></section>

<section class="section supporting-section"><div class="container">
  <div class="section-heading-row"><div><div class="eyebrow">More evidence</div><h2>Additional operating examples.</h2></div><p class="section-note">Change management, data quality, customer experience, and supply operations.</p></div>
  <div class="case-grid supporting-grid">
    {supportingCases.map((c,i) => <article class={`case-card ${c.tone}`}><div class="case-number">{String(i+5).padStart(2,'0')}</div><div class="kicker">{c.context}</div><h3>{c.title}</h3><div class="case-section"><strong>Challenge</strong><p>{c.challenge}</p></div><div class="case-section"><strong>Action</strong><p>{c.action}</p></div><div class="case-section result"><strong>Result</strong><p>{c.outcome}</p></div></article>)}
  </div>
</div></section>

<section class="section tight"><div class="container"><div class="callout"><strong>Want the career timeline instead?</strong> The résumé provides the chronology; the role-specific pages organize the same verified experience by hiring need.</div><div class="actions"><a class="button" href="/resume/">View résumé</a><a class="button secondary" href="/operations-leadership/">Operations & leadership</a><a class="button secondary" href="/contact/">Contact</a></div></div></section>

<style>
  .case-hero{padding:4.6rem 0 3.8rem;background:linear-gradient(128deg,#102f55 0%,#153e75 55%,#0f6769 100%);color:#fff;overflow:hidden}.case-hero-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(280px,.7fr);gap:3rem;align-items:end}.case-hero h1{font-size:clamp(2.8rem,6vw,5rem);line-height:1;margin:.7rem 0 1.2rem;letter-spacing:-.05em}.case-hero .lede{color:#e5eef5}.case-hero-proof{display:grid;grid-template-columns:1fr 1fr;border:1px solid rgba(255,255,255,.18);border-radius:20px;overflow:hidden;background:rgba(255,255,255,.06)}.case-hero-proof span{padding:1rem;border-right:1px solid rgba(255,255,255,.12);border-bottom:1px solid rgba(255,255,255,.12);color:#dbe8f1;font-size:.82rem;line-height:1.35}.case-hero-proof strong{display:block;font-size:1.7rem;color:#fff}.flagship-section{background:linear-gradient(180deg,#f7f9fc 0%,#fff 100%)}.flagship{--story:var(--teal);margin:1.4rem 0 2rem;border:1px solid var(--border);border-top:5px solid var(--story);border-radius:24px;background:#fff;overflow:hidden;box-shadow:0 18px 48px rgba(23,32,42,.07)}.flagship-blue{--story:var(--accent-2)}.flagship-violet{--story:var(--violet)}.flagship-gold{--story:var(--gold)}.flagship-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;padding:1.5rem 1.6rem 1.2rem;border-bottom:1px solid var(--border)}.flagship-no{display:inline-block;font-weight:900;color:var(--story);letter-spacing:.08em;font-size:.8rem;margin-bottom:.4rem}.flagship-heading h3{font-size:clamp(1.45rem,3vw,2.05rem);margin:.3rem 0 0}.flagship-result{display:flex;align-items:center;gap:.8rem;max-width:340px}.flagship-result strong{font-size:2.55rem;line-height:1;color:var(--story)}.flagship-result span{font-size:.88rem;color:var(--muted);line-height:1.35}.flagship-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr);gap:0}.flagship-grid.reverse{grid-template-columns:minmax(300px,.75fr) minmax(0,1.25fr)}.flagship-grid.reverse .visual-panel{order:2}.visual-panel{min-height:330px;padding:2rem;background:color-mix(in srgb,var(--story) 7%,#f9fbfd);display:flex;align-items:center;justify-content:center}.story-copy{padding:1.7rem;display:grid;align-content:center;gap:1rem}.story-copy>div{padding-bottom:.9rem;border-bottom:1px solid var(--border)}.story-copy>div:last-child{border-bottom:0;padding-bottom:0}.story-copy strong{color:var(--story);font-size:.78rem;text-transform:uppercase;letter-spacing:.1em}.story-copy p{margin:.3rem 0 0;color:var(--muted)}.story-outcome p{color:var(--ink)!important;font-weight:650}.org-story{gap:1rem}.progression-step{width:min(220px,44%);min-height:180px;border:1px solid color-mix(in srgb,var(--story) 30%,white);background:#fff;border-radius:18px;padding:1.3rem;display:flex;flex-direction:column;justify-content:center;text-align:center;box-shadow:0 10px 26px rgba(23,32,42,.06)}.progression-step small{font-weight:850;color:var(--story);letter-spacing:.06em}.progression-step>strong{font-size:3.3rem;line-height:1;color:var(--story);margin:.45rem 0}.progression-step>span{color:var(--muted);font-size:.9rem}.manager-step{width:min(310px,52%)}.progression-arrow{font-size:2rem;color:#91a1b4}.lead-chips{display:flex;flex-wrap:wrap;justify-content:center;gap:.3rem;margin-top:.8rem}.lead-chips i{font-style:normal;border-radius:999px;background:var(--teal-soft);color:var(--teal);font-size:.7rem;font-weight:850;padding:.22rem .4rem}.lead-chips b{width:100%;font-size:.7rem;color:var(--muted);font-weight:650}.sop-story{gap:.7rem}.sop-story-step{width:29%;min-height:190px;padding:1rem;border-radius:18px;background:#fff;border:1px solid var(--border);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}.sop-story-step>strong{color:var(--story);font-size:1.15rem}.sop-story-step small{color:var(--muted);font-size:.78rem;line-height:1.35;margin-top:.3rem}.story-arrow{font-size:1.7rem;color:#91a1b4}.paper-mini{width:62px;height:54px;position:relative;margin-bottom:.75rem}.paper-mini i{position:absolute;width:44px;height:50px;border-radius:4px;background:#fff;border:1px solid #9db1c6;left:9px;top:2px}.paper-mini i:nth-child(2){transform:rotate(7deg);left:15px}.paper-mini i:nth-child(3){transform:rotate(-8deg);left:3px}.standard-ring{width:62px;height:62px;border-radius:50%;display:grid;place-items:center;border:8px solid var(--blue-soft);box-shadow:inset 0 0 0 2px var(--accent-2);font-size:.75rem;font-weight:900;color:var(--accent-2);margin-bottom:.7rem}.sop-story-step.library>strong{font-size:2.6rem;line-height:1}.sop-story-step.library>span{font-weight:800;color:var(--story)}.migration-story{gap:1rem}.host-box{width:28%;min-height:165px;border-radius:18px;padding:1rem;display:flex;flex-direction:column;justify-content:center;text-align:center;background:#fff;border:1px solid var(--border)}.host-box small{font-weight:900;letter-spacing:.09em;color:var(--story)}.host-box strong{font-size:1rem;margin:.45rem 0}.host-box span{font-size:.8rem;color:var(--teal);font-weight:850}.migration-middle{flex:1;text-align:center;min-width:0}.agency-dots{display:grid;grid-template-columns:repeat(6,8px);justify-content:center;gap:5px;margin-bottom:.7rem}.agency-dots i{width:8px;height:8px;border-radius:50%;background:color-mix(in srgb,var(--story) 65%,white)}.migration-line{height:4px;background:#dfe6ee;position:relative;margin:.6rem 0 .8rem;border-radius:999px;overflow:hidden}.migration-line span{display:block;width:86%;height:100%;background:linear-gradient(90deg,var(--violet),var(--teal));border-radius:999px}.migration-middle>strong{display:block;color:var(--story)}.migration-middle>small{display:block;color:var(--muted);font-size:.72rem;line-height:1.35;margin-top:.35rem}.journey-story{display:block}.journey-track{display:grid;grid-template-columns:repeat(5,1fr);align-items:center;margin:2.1rem 0 .5rem;position:relative}.journey-track:before{content:"";position:absolute;left:6%;right:6%;height:4px;background:linear-gradient(90deg,var(--gold),var(--teal),var(--accent-2),var(--violet));border-radius:999px}.journey-track span{width:20px;height:20px;border-radius:50%;background:#fff;border:5px solid var(--gold);z-index:1;justify-self:center}.journey-track span:nth-child(2){border-color:var(--teal)}.journey-track span:nth-child(3){border-color:var(--accent-2)}.journey-track span:nth-child(4){border-color:var(--violet)}.journey-track span:nth-child(5){border-color:var(--gold)}.journey-labels{display:grid;grid-template-columns:repeat(5,1fr);gap:.4rem;text-align:center}.journey-labels strong{display:block;font-size:.82rem}.journey-labels small{color:var(--muted);font-size:.7rem}.journey-people{margin:2rem auto 0;width:min(300px,90%);padding:1rem;border-radius:16px;background:#fff;border:1px solid var(--border);text-align:center}.journey-people strong{display:block;font-size:2rem;color:var(--story)}.journey-people span{font-size:.8rem;color:var(--muted)}.supporting-section{background:#f7f8fa}.supporting-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.case-card{--case:var(--accent-2);background:#fff;border:1px solid var(--border);border-top:4px solid var(--case);border-radius:18px;padding:1.35rem;box-shadow:0 9px 26px rgba(23,32,42,.05)}.case-card.teal{--case:var(--teal)}.case-card.blue{--case:var(--accent-2)}.case-card.gold{--case:var(--gold)}.case-card.violet{--case:var(--violet)}.case-number{font-size:.75rem;font-weight:900;color:var(--case);letter-spacing:.1em}.case-card h3{margin:.4rem 0 1rem}.case-section{margin-top:.85rem}.case-section strong{font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;color:var(--case)}.case-section p{margin:.2rem 0;color:var(--muted)}.case-section.result p{color:var(--ink);font-weight:600}@media(max-width:900px){.case-hero-grid,.flagship-grid,.flagship-grid.reverse{grid-template-columns:1fr}.flagship-grid.reverse .visual-panel{order:0}.flagship-heading{align-items:flex-start;flex-direction:column}.flagship-result{max-width:none}.visual-panel{min-height:0}.supporting-grid{grid-template-columns:1fr}}@media(max-width:650px){.case-hero-proof{grid-template-columns:1fr}.org-story,.migration-story,.sop-story{flex-direction:column}.progression-step,.manager-step,.host-box,.sop-story-step{width:100%}.progression-arrow,.story-arrow{transform:rotate(90deg)}.journey-labels{grid-template-columns:1fr;gap:.75rem}.journey-track{display:none}.journey-labels div{padding:.65rem;border-left:4px solid var(--gold);background:#fff;border-radius:0 10px 10px 0;text-align:left}.case-hero{padding-top:3.5rem}}
</style>
</BaseLayout>
