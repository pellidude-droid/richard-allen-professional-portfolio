---
import BaseLayout from '../layouts/BaseLayout.astro';
const cases = [
  {title:'Building and governing an SOP system', context:'Oregon Employment Department', challenge:'Operational knowledge was scattered and needed a consistent, maintainable system rather than another one-time documentation push.', action:'Led the year-long project and project team; created 100 new SOPs; corrected and standardized 25+ legacy SOPs; established standards; reviewed and accepted completed work; coached contributors; built the centralized repository; and set guidelines for future creation, maintenance, and updates.', outcome:'Established a controlled, repeatable documentation system that could continue after the project itself ended.'},
  {title:'Co-leading the Customer Journey', context:'HawkSoft', challenge:'The company needed a clearer view of the customer experience across departments and across the full customer relationship.', action:'Co-led the cross-functional Customer Journey project for about a year, mapping touchpoints from initial need and sales through ongoing use and eventual retirement, connecting customer experience, support, training, and process improvement.', outcome:'Created a shared framework for seeing customer friction and handoffs across the lifecycle without relying on one department’s view.'},
  {title:'Preparing a support organization for an accounting redesign', context:'HawkSoft', challenge:'A major accounting-software redesign required old processes to change and support staff to learn new workflows and troubleshooting methods before customers encountered them.', action:'Communicated the change and expectations six months in advance, arranged biweekly developer/staff education during the final two months, provided extra support and access to developers/management at go-live, and continued training for months afterward.', outcome:'Built staff readiness before launch and sustained learning after go-live rather than treating change management as a launch-day event.'},
  {title:'Moving customers through a major online transition', context:'HawkSoft', challenge:'Customers needed to move between local/online environments and, in a later transition Richard recalls directly, hundreds of users needed to move from an inferior online service to a substantially improved one.', action:'Project-managed/coordinated database moves between local networks and HawkSoft Online and supported customers through technical, workflow, and training changes.', outcome:'Helped customers navigate a significant technology transition while connecting technical migration work with practical adoption support.'},
  {title:'Turning raw service data into management decisions', context:'HawkSoft', challenge:'Raw customer-service and phone data needed to become something management could use.', action:'Built recurring reports, analyzed trends, and developed recommendations on staffing, training, policy/process improvement, and future needs; historical interview material says many recommendations were implemented and Richard presented analysis to upper management.', outcome:'Converted operational activity into a repeatable management-information process rather than leaving data as an unused export.'},
  {title:'Managing workforce visibility at scale', context:'Oregon Health Authority', challenge:'Leaders needed accurate position information across multiple divisions and functions.', action:'Managed 400+ position records, organizational charts, trackers, and 20+ recurring/ad-hoc workforce reports while coordinating with HR, Recruiting, Budget, Classification & Compensation, DEI, and leadership.', outcome:'Improved the availability and consistency of workforce information used for operational decisions.'}
];
---
<BaseLayout title="Selected Work / Case Studies" current="/case-studies/" description="Selected, source-controlled case studies from Richard Allen's work in process improvement, SaaS support, change management, customer experience, analytics, and operations.">
<section class="page-intro"><div class="container"><div class="eyebrow">Selected Work / Case Studies</div><h1>Examples of how I approach messy operational problems.</h1><p class="lede">These examples stay within source-controlled facts. They emphasize what I did, how I worked, and the scale supported by my career records rather than adding unsupported percentages.</p></div></section>
<section class="section"><div class="container timeline">
  {cases.map(c => <article class="card"><div class="kicker">{c.context}</div><h2>{c.title}</h2><p><strong>Challenge:</strong> {c.challenge}</p><p><strong>Action:</strong> {c.action}</p><p><strong>Result:</strong> {c.outcome}</p></article>)}
</div></section>
</BaseLayout>
