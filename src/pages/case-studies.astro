---
import BaseLayout from '../layouts/BaseLayout.astro';
const cases = [
  {title:'Building and governing an SOP system', context:'Oregon Employment Department', challenge:'Operational knowledge was scattered and needed a consistent, maintainable system rather than another one-time documentation push.', action:'Led the year-long project and project team; created 100 new SOPs; corrected and standardized 25+ legacy SOPs; established standards; reviewed and accepted completed work; coached contributors; built the centralized repository; and set guidelines for future creation, maintenance, and updates.', outcome:'Established a controlled, repeatable documentation system that could continue after the project itself ended.'},
  {title:'Co-leading the Customer Journey', context:'HawkSoft', challenge:'The company needed a clearer view of the customer experience across departments and across the full customer relationship.', action:'Co-led the cross-functional Customer Journey project for about a year, mapping touchpoints across an average customer relationship of roughly eight years—from initial need and sales through ongoing use and eventual retirement.', outcome:'Created a shared lifecycle framework that made customer friction and handoffs more visible across departments and materially helped improve customer retention.'},
  {title:'Running service operations through measurable OKRs', context:'HawkSoft', challenge:'A growing support organization needed clear operating measures, consistent coaching, and a way to compare team performance.', action:'Helped establish staff and departmental objectives and key results covering measures such as calls taken and resolved, Tier 2/3 forwards, call length, support tickets taken, tickets closed, and other service metrics while managing a 32-person Customer Support and Technical Support organization.', outcome:'Created a more measurable operating cadence; Richard’s team frequently exceeded peer teams on company OKRs.'},
  {title:'Preparing a support organization for an accounting redesign', context:'HawkSoft', challenge:'A major accounting-software redesign required old processes to change and support staff to learn new workflows and troubleshooting methods before customers encountered them.', action:'Communicated the change and expectations six months in advance, arranged biweekly developer/staff education during the final two months, provided extra support and access to developers/management at go-live, and continued training for months afterward.', outcome:'Built staff readiness before launch and sustained learning after go-live rather than treating change management as a launch-day event.'},
  {title:'Turning raw service data into management decisions', context:'HawkSoft', challenge:'Raw customer-service and phone data needed to become something management could use.', action:'Built recurring reports, analyzed trends, and developed recommendations on staffing, training, policy, procedures, and future needs. Richard’s manager presented the reports initially; Richard later presented most of the reporting himself to directors and upper management.', outcome:'Converted operational activity into a repeatable management-information process that drove procedure additions, removals, and other operational course corrections.'},
  {title:'Managing workforce visibility at scale', context:'Oregon Health Authority', challenge:'Leaders needed accurate position information across multiple divisions and functions.', action:'Managed 400+ position records, organizational charts, trackers, and 20+ recurring/specialized workforce reports while coordinating with HR, Recruiting, Budget, Classification & Compensation, DEI, and leadership. Reporting included monthly and specialized work for the CFO area and, at times, the CFO’s superior.', outcome:'Improved the availability and consistency of workforce information used for operational and leadership decisions.'},
  {title:'Connecting product testing, documentation, and customer success', context:'The Kotter Group', challenge:'Bridge XLerator was being prepared for customer launch and a major industry event, while the company needed reliable product validation, usable training material, and stronger customer-success feedback.', action:'Built the Customer Experience / Customer Success function and maintained relationships with owners across the full client base. Surviving 2019 work product explicitly assigns Richard to document each XLerator feature and benefit, write user stories and business cases for features, document how features worked, and participate with the development team. Separate testing notes show systematic feature-by-feature testing, repeatable defect reproduction, usability findings, and interface/error-message recommendations. Richard also created release/training documentation, instructional videos, taught customers over Zoom, and supported trade-show work.', outcome:'Connected customer feedback, development discussions, functional testing, product documentation, release readiness, and customer education into a practical operating loop.'},
  {title:'Modernizing X-ray tracking and digitization', context:'Shady Grove Adventist Hospital', challenge:'A DOS-based film-tracking process needed modernization while a large physical X-ray archive was being converted to digital form.', action:'Helped implement a new tracking system and helped create the process and procedures used to digitize thousands of X-ray films.', outcome:'Measurements taken as part of the transition showed an approximately 30% efficiency improvement while supporting a major digitization effort.'}
];
---
<BaseLayout title="Selected Work / Case Studies" current="/case-studies/" description="Selected, source-controlled case studies from Richard Allen's work in operations management, process improvement, SaaS support, change management, customer experience, analytics, product documentation, and systems modernization.">
<section class="page-intro"><div class="container"><div class="eyebrow">Selected Work / Case Studies</div><h1>Examples of how I approach messy operational problems.</h1><p class="lede">These examples emphasize the management systems behind the work: people, measures, process, reporting, technology, cross-functional coordination, and sustained follow-through.</p></div></section>
<section class="section"><div class="container timeline">
  {cases.map(c => <article class="card"><div class="kicker">{c.context}</div><h2>{c.title}</h2><p><strong>Challenge:</strong> {c.challenge}</p><p><strong>Action:</strong> {c.action}</p><p><strong>Result:</strong> {c.outcome}</p></article>)}
</div></section>
</BaseLayout>
